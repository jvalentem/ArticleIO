<%- include( pastaAtual + '/partials/header.ejs')%>

    <section class="perfil">
        <div class="center">
            <h1>Perfil de <%= usuarioLogado.nome%> (<%= usuarioLogado.acesso %>) </h1>
            <h3>Data de entrada: <%= usuarioLogado.dataEntrada %></h3>
            <div id="profile-action-buttons">
                <p>Nome de usuário: <%= usuarioLogado.username%> <a href="/perfil/alteraruser">Alterar</a></p>
                <p>Senha: <%for(let i=0;i<usuarioLogado.password.length;i++){%>*<%}%> <a href="/perfil/alterarsenha">Alterar</a></p>
                <p>Email: <% for(let i=0;i<usuarioLogado.email.length;i++){%>*<%}%> %> <a href="/perfil/alteraremail">Alterar</a></p>
            </div>
            <h2><%= posts.length %> artigos publicados</h2>

            <% if(posts.length > 0){ %>
                <h2>Seus artigos:</h2>

                <div class="artigos">

                <% for(let i=0; i < posts.length; i++){%>
                <div class="box">
                    <img src= <%= posts[i].imagem %> alt="">
                    <div class="conteudo-noticia">
                        <h3><%= posts[i].titulo %></h3>
                        <h4><%= posts[i].categoria %></h4>
                        <p>
                            <%if(posts[i].descricao_curta.length < 50){%>
                                <%= posts[i].introducao %>
                            <%}else{%>
                                <%= posts[i].descricao_curta %>
                            <%}%>
                        </p>
                        <a href=<%= "/" + posts[i].slug %>>Ler artigo</a>
                        <button type="button" class="danger-button delete-post-btn" data-slug="<%= posts[i].slug %>">Apagar</button>
                    </div>
                </div>

                <%}%>
            <% } %>
                </div>
        </div>
    </section>


<%- include(pastaAtual + '/partials/delete-post-script.html') %>    
<%- include( pastaAtual + '/partials/footer.html')%>